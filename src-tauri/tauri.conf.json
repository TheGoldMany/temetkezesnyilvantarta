{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunda Temető",
  "version": "0.1.0",
  "identifier": "hu.lunda.temeto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lunda Temető",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "Lunda Software",
    "copyright": "© 2026 Lunda Software",
    "category": "Business",
    "shortDescription": "Temetőnyilvántartó",
    "longDescription": "Temetőnyilvántartó asztali alkalmazás: nyilvántartó könyv, sírbolt könyv, megváltások, lejáratok, térkép.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["Hungarian"], "displayLanguageSelector": false, "installMode": "perMachine" },
      "wix": { "language": "hu-HU" }
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": ["https://updates.lunda.hu/temeto/{{target}}/{{arch}}/{{current_version}}"]
    }
  }
}
